version: "3.9"

services:
  backend:
    build:
      context: ./backend
    container_name: aura-backend
    ports:
      - "3001:3001"
    env_file:
      - .env
    environment:
      PORT: 3001
      FRONTEND_URL: http://localhost:5173

  frontend:
    build:
      context: ./frontend
    container_name: aura-frontend
    ports:
      - "5173:5173"
    env_file:
      - .env
    environment:
      VITE_API_BASE_URL: http://localhost:3001
    depends_on:
      - backend
